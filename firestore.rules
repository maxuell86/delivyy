rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && 
        request.auth.token.email == 'maxuell86@gmail.com' && 
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSuperAdminEmail() || 
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidStoreConfig(data) {
      return data.keys().hasAll(['nome', 'whatsapp']) &&
        data.nome is string && data.nome.size() <= 100 &&
        data.whatsapp is string && data.whatsapp.size() <= 20;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'nome', 'preco', 'categoriaId', 'disponivel']) &&
        data.id is string && data.id.size() <= 64 &&
        data.nome is string && data.nome.size() <= 100 &&
        data.preco is number && data.preco >= 0 &&
        data.categoriaId is string && data.categoriaId.size() <= 50 &&
        data.disponivel is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'numeroPedido', 'clienteNome', 'clienteTelefone', 'status', 'total']) &&
        data.id is string && data.id.size() <= 64 &&
        data.numeroPedido is number &&
        data.clienteNome is string && data.clienteNome.size() <= 100 &&
        data.clienteTelefone is string && data.clienteTelefone.size() <= 30 &&
        data.status in ['pendente', 'preparando', 'pronto', 'entregue', 'cancelado'] &&
        data.total is number && data.total >= 0;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 150 &&
        data.role in ['admin', 'kitchen', 'attendant'];
    }

    // Collection 1: Store Configuration
    match /store_config/{configId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidStoreConfig(incoming());
      allow delete: if isAdmin();
    }

    // Collection 2: Products Menu
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Collection 3: Kitchen & Delivery Orders
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && incoming().id == orderId;
      allow update: if isAdmin() && isValidId(orderId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Collection 4: Admin Team Members
    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if (isSuperAdminEmail() || isAdmin()) && isValidId(userId) && isValidAdminUser(incoming());
      allow delete: if isSuperAdminEmail() && request.auth.uid != userId;
    }
  }
}
